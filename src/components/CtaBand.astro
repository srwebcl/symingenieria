---
import ContactForm from "./ContactForm.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
interface Props { title?: string; text?: string; preset?: string }
const {
  title = "Cotice su proyecto con nuestros profesionales",
  text = "Cuéntenos qué necesita y coordinamos una reunión en Calama, Santiago o La Serena.",
  preset,
} = Astro.props;
---
<section class="section section-cta" id="cotizar">
  <div class="wrap grid-2-cta">
    <div class="cta-text">
      <h2>{title}</h2>
      <p class="lead-cta">{text}</p>
      <ul class="direct-cta">
        <li>
          <span class="cta-label">Vía Telefónica</span>
          <a href={site.phoneHref}>{site.phone}</a>
        </li>
        <li>
          <span class="cta-label">Consultas Formales</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
      </ul>
    </div>
    <div class="cta-form-container">
      <ContactForm preset={preset} />
    </div>
  </div>
</section>
<style>
  .section-cta { 
    background: var(--stone, #F8FAFC);
    padding-block: clamp(80px, 12vw, 160px); 
  }
  .grid-2-cta { 
    display: grid; gap: 64px; grid-template-columns: 1fr; align-items: flex-start; 
  }
  @media (min-width: 900px) { 
    .grid-2-cta { grid-template-columns: 1fr 1.2fr; gap: 120px; } 
  }
  
  .cta-text h2 { 
    font-family: var(--display);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 24px 0;
  }
  .lead-cta { 
    font-size: clamp(1.2rem, 1.5vw, 1.5rem); 
    color: var(--text-secondary); 
    line-height: 1.5; 
    margin-bottom: 64px; 
    max-width: 35ch;
  }
  
  .direct-cta { 
    list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 32px; 
  }
  .direct-cta li { 
    display: flex; flex-direction: column; gap: 8px;
  }
  .cta-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(0,0,0,0.4);
  }
  .direct-cta a { 
    font-family: var(--display);
    color: var(--corporate-blue, #0A3D62); 
    font-size: clamp(1.4rem, 2vw, 1.8rem); 
    text-decoration: none; 
    transition: color 0.4s;
  }
  .direct-cta a:hover { color: var(--accent); }
</style>
