---
import ContactForm from "./ContactForm.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
interface Props { title?: string; text?: string; preset?: string }
const {
  title = "Cotice su proyecto con nuestros profesionales",
  text = "Cuéntenos qué necesita y coordinamos una reunión en Calama, Santiago o La Serena.",
  preset,
} = Astro.props;
---
<section class="section section--ink band" id="cotizar">
  <div class="wrap grid-2">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
      <ul class="direct">
        <li><Icon name="phone" size={22} /><a href={site.phoneHref}>{site.phone}</a></li>
        <li><Icon name="whatsapp" size={22} /><a href={site.whatsapp} target="_blank" rel="noopener">Escribir por WhatsApp</a></li>
        <li><Icon name="mail" size={22} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <ContactForm preset={preset} dark />
  </div>
</section>
<style>
  .band { border-top: 6px solid var(--accent); }
  .direct { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 14px; }
  .direct li { display: flex; gap: 12px; align-items: center; color: var(--accent); }
  .direct a { color: var(--white); text-decoration: none; font-weight: 600; }
  .direct a:hover { text-decoration: underline; }
</style>
