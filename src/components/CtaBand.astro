---
import ContactForm from "./ContactForm.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
interface Props { title?: string; text?: string; preset?: string }
const {
  title = "Cotice su proyecto con nuestros profesionales",
  text = "Cuéntenos qué necesita y coordinamos una reunión en Calama, Santiago o La Serena.",
  preset,
} = Astro.props;
---
<section class="section section-cta" id="cotizar">
  <div class="wrap grid-2-cta">
    <div class="cta-text">
      <h2>{title}</h2>
      <p class="lead-cta">{text}</p>
      <ul class="direct-cta">
        <li><Icon name="phone" size={24} /><a href={site.phoneHref}>{site.phone}</a></li>
        <li><Icon name="whatsapp" size={24} /><a href={site.whatsapp} target="_blank" rel="noopener">Escribir por WhatsApp</a></li>
        <li><Icon name="mail" size={24} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <div class="cta-form-container">
      <ContactForm preset={preset} />
    </div>
  </div>
</section>
<style>
  .section-cta { 
    background: #F5F5F7; /* Pearl gray to separate from Footer */
    padding-block: clamp(80px, 12vw, 160px); 
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .grid-2-cta { 
    display: grid; gap: 64px; grid-template-columns: 1fr; align-items: flex-start; 
  }
  @media (min-width: 900px) { .grid-2-cta { grid-template-columns: 1fr 1fr; gap: 120px; } }
  
  .cta-text h2 { 
    font-family: var(--display);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 24px;
  }
  .lead-cta { 
    font-size: 1.25rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 48px; 
  }
  
  .direct-cta { list-style: none; padding: 0; margin: 0; display: grid; gap: 24px; }
  .direct-cta li { display: flex; gap: 16px; align-items: center; color: var(--accent); }
  .direct-cta a { 
    color: var(--text-primary); font-size: 1.1rem; text-decoration: none; font-weight: 500; 
    transition: var(--transition-smooth);
  }
  .direct-cta a:hover { color: var(--accent); }
</style>
