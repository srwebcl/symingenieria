---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { services } from "../data/services";
import { site } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="hdr">
  <div class="wrap bar">
    <Logo light />
    <nav class="nav" aria-label="Principal">
      <a href="/" aria-current={isActive("/") ? "page" : undefined}>Inicio</a>
      <a href="/nosotros" aria-current={isActive("/nosotros") ? "page" : undefined}>Nosotros</a>
      <div class="has-mega">
        <button class="mega-btn" aria-expanded="false" aria-controls="mega" data-active={isActive("/especialidades") || undefined}>
          Especialidades
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="2" fill="none"/></svg>
        </button>
        <div class="mega" id="mega" hidden>
          <div class="wrap mega-in">
            <div class="mega-intro">
              <h2>Especialidades</h2>
              <p>Cinco especialidades que cubren un proyecto minero o industrial completo.</p>
              <a class="more" href="/especialidades"><span class="dot"><Icon name="arrow" size={18} /></span>Ver todas</a>
            </div>
            <div class="mega-list">
              <h3>Todas las especialidades</h3>
              <ul>{services.map((s) => <li><a href={`/especialidades/${s.slug}`}>{s.name}</a></li>)}</ul>
            </div>
          </div>
        </div>
      </div>
      <a href="/soluciones-mineria" aria-current={isActive("/soluciones-mineria") ? "page" : undefined}>Soluciones</a>
      <a href="/proyectos" aria-current={isActive("/proyectos") ? "page" : undefined}>Proyectos</a>
    </nav>
    <div class="actions">
      <a class="btn-pro" href="/contacto">Cotizar proyecto <span class="arrow-pro">↗</span></a>
      <button class="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="drawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="drawer" id="drawer" hidden>
    <nav class="wrap" aria-label="Menú móvil">
      <a href="/">Inicio</a>
      <a href="/nosotros">Nosotros</a>
      <a href="/especialidades">Especialidades</a>
      <ul>{services.map((s) => <li><a href={`/especialidades/${s.slug}`}>{s.name}</a></li>)}</ul>
      <a href="/soluciones-mineria">Soluciones</a>
      <a href="/proyectos">Proyectos</a>
      <a href="/contacto">Contacto</a>
      <a class="btn" href={site.phoneHref}>Llamar {site.phone}</a>
    </nav>
  </div>
</header>

<script>
  const megaBtn = document.querySelector<HTMLButtonElement>(".mega-btn");
  const mega = document.getElementById("mega");
  const burger = document.querySelector<HTMLButtonElement>(".burger");
  const drawer = document.getElementById("drawer");

  const toggle = (btn: HTMLButtonElement | null, panel: HTMLElement | null, force?: boolean) => {
    if (!btn || !panel) return;
    const open = force ?? btn.getAttribute("aria-expanded") !== "true";
    btn.setAttribute("aria-expanded", String(open));
    
    if (panel === drawer) {
      if (open) {
        panel.hidden = false;
        requestAnimationFrame(() => panel.classList.add("is-open"));
        document.body.style.overflow = "hidden";
      } else {
        panel.classList.remove("is-open");
        setTimeout(() => { panel.hidden = true; }, 400);
        document.body.style.overflow = "";
      }
    } else {
      panel.hidden = !open;
    }
  };

  megaBtn?.addEventListener("click", () => toggle(megaBtn, mega));
  burger?.addEventListener("click", () => toggle(burger, drawer));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") { toggle(megaBtn, mega, false); toggle(burger, drawer, false); }
  });
  document.addEventListener("click", (e) => {
    const t = e.target as Node;
    if (mega && !mega.hidden && !mega.contains(t) && !megaBtn?.contains(t)) toggle(megaBtn, mega, false);
  });
</script>

<style>
  .hdr { 
    position: sticky; top: 0; z-index: 50; 
    background-color: var(--ink); /* Footer Blue (Slate 900) */
    border-bottom: 1px solid rgba(255, 255, 255, 0.1); 
    transition: var(--transition-base);
    animation: slideDown 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes slideDown {
    from { transform: translateY(-100%); }
    to { transform: translateY(0); }
  }

  .bar { height: var(--header-h); display: flex; align-items: center; gap: 32px; }
  .nav { display: none; gap: 30px; margin-left: auto; align-items: center; }
  .nav > a, .mega-btn {
    font-family: var(--display); font-weight: 600; font-size: 1rem; text-decoration: none; color: var(--white);
    background: none; border: 0; padding: 26px 0; cursor: pointer; display: inline-flex; gap: 6px; align-items: center;
    border-bottom: 3px solid transparent; opacity: 0.9;
    transition: var(--transition-base);
  }
  .nav > a:hover, .mega-btn:hover { color: var(--white); opacity: 1; border-bottom-color: rgba(255, 255, 255, 0.5); }
  .nav > a[aria-current="page"], .mega-btn[data-active] { border-bottom-color: var(--accent); opacity: 1; }
  .mega-btn svg { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
  .mega-btn[aria-expanded="true"] svg { transform: rotate(180deg); }

  .mega { 
    position: absolute; left: 0; right: 0; top: 100%; 
    background: #FFFFFF; 
    border-bottom: 2px solid var(--accent); 
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15); 
    border-radius: 0;
    overflow: hidden;
  }
  .mega-in { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(32px, 5vw, 64px); padding-block: 44px 52px; }
  .mega h2 { font-family: var(--display); font-size: 2.2rem; color: #000000; margin-bottom: 12px; }
  .mega h3 { font-family: var(--display); font-size: 1.1rem; color: #000000; font-weight: 700; margin-bottom: 16px; border-bottom: 1px solid rgba(0,0,0,0.1); padding-bottom: 8px; }
  .mega p { color: #666666; font-size: 1.1rem; margin-bottom: 24px; }
  .mega ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .mega li a { 
    display: block; padding: 12px 0; border-bottom: 1px solid rgba(0,0,0,0.08); 
    text-decoration: none; font-weight: 500; color: #333333;
    transition: var(--transition-base);
  }
  .mega li a:hover { color: var(--accent); padding-left: 6px; border-bottom-color: var(--accent); }
  .mega li:last-child a { border-bottom: 1px solid rgba(0,0,0,0.08); } 
  
  .more { color: var(--accent); font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
  .more:hover { text-decoration: underline; }

  .actions { display: flex; align-items: center; gap: 20px; margin-left: auto; }
  
  /* PRO CTA button for Header */
  .btn-pro { 
    display: none; 
    align-items: center;
    gap: 8px;
    padding: 10px 16px 10px 24px; 
    font-size: 0.95rem; 
    font-weight: 600; 
    background: transparent; 
    color: #FFF; 
    text-decoration: none; 
    border: 1px solid rgba(255, 255, 255, 0.3); 
    border-radius: 0; 
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .arrow-pro {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #FFF;
    width: 24px;
    height: 24px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-pro:hover { 
    background: rgba(255, 255, 255, 0.05); 
    border-color: #FFF; 
  }
  .btn-pro:hover .arrow-pro {
    transform: translate(2px, -2px);
    background: #FFF;
    color: #000;
  }

  .burger { width: 44px; height: 44px; background: none; border: 0; display: grid; place-content: center; gap: 6px; cursor: pointer; }
  .burger span { width: 24px; height: 2px; background: var(--white); display: block; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s; }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  .drawer { 
    position: absolute; top: 100%; left: 0; right: 0; 
    height: 100vh;
    background: #FFFFFF; overflow-y: auto; 
    padding-block: 0 40px; 
    border-top: 1px solid rgba(0,0,0,0.1); 
    opacity: 0;
    transform: translateY(-20px);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .drawer.is-open {
    opacity: 1;
    transform: translateY(0);
  }
  
  .drawer nav {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--header-h) - 40px);
  }
  
  .drawer nav > a:not(.btn) { 
    display: block; 
    font-family: var(--display); 
    font-size: clamp(2rem, 8vw, 2.8rem); /* Massive typography */
    font-weight: 400; 
    letter-spacing: -0.03em;
    padding: 24px 0; 
    text-decoration: none; 
    border-bottom: 2px solid #000000; /* Brutalist thick border */
    color: #000; 
    transition: padding-left 0.3s;
  }
  .drawer nav > a:not(.btn):hover {
    padding-left: 12px;
    color: var(--accent);
  }
  
  .drawer ul { 
    list-style: none; margin: 0 0 auto 0; 
    padding: 24px 0 32px 24px; 
    border-left: 4px solid var(--accent); /* Structural accent line */
  }
  .drawer li a { 
    display: block; padding: 12px 0; 
    text-decoration: none; color: #333; 
    font-size: 1.2rem;
    font-weight: 500; 
  }
  .drawer .btn { 
    margin-top: 40px; 
    width: 100%; 
    border-radius: 0; 
    padding: 20px;
    font-size: 1.1rem;
    text-align: center;
  }

  @media (min-width: 1080px) {
    .nav { display: flex; }
    .actions { margin-left: 0; }
    .btn-pro { display: inline-flex; }
    .burger { display: none; }
    .drawer { display: none; }
  }
  @media (min-width: 1280px) { .tel { display: inline; } }
</style>
