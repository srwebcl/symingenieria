---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { services } from "../data/services";
import { site } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="hdr">
  <div class="wrap bar">
    <Logo light />
    <nav class="nav" aria-label="Principal">
      <a href="/" aria-current={isActive("/") ? "page" : undefined}>Inicio</a>
      <a href="/nosotros" aria-current={isActive("/nosotros") ? "page" : undefined}>Nosotros</a>
      <div class="has-mega">
        <button class="mega-btn" aria-expanded="false" aria-controls="mega" data-active={isActive("/especialidades") || undefined}>
          Especialidades
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="2" fill="none"/></svg>
        </button>
        <div class="mega" id="mega" hidden>
          <div class="wrap mega-in">
            <div class="mega-intro">
              <h2>Especialidades</h2>
              <p>Cinco especialidades que cubren un proyecto minero o industrial completo.</p>
              <a class="more" href="/especialidades"><span class="dot"><Icon name="arrow" size={18} /></span>Ver todas</a>
            </div>
            <div class="mega-list">
              <h3>Todas las especialidades</h3>
              <ul>{services.map((s) => <li><a href={`/especialidades/${s.slug}`}>{s.name}</a></li>)}</ul>
            </div>
          </div>
        </div>
      </div>
      <a href="/soluciones-mineria" aria-current={isActive("/soluciones-mineria") ? "page" : undefined}>Soluciones</a>
      <a href="/proyectos" aria-current={isActive("/proyectos") ? "page" : undefined}>Proyectos</a>
    </nav>
    <div class="actions">
      <a class="tel" href={site.phoneHref}>{site.phone}</a>
      <a class="btn cta" href="/contacto">Cotizar proyecto</a>
      <button class="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="drawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="drawer" id="drawer" hidden>
    <nav class="wrap" aria-label="Menú móvil">
      <a href="/">Inicio</a>
      <a href="/nosotros">Nosotros</a>
      <a href="/especialidades">Especialidades</a>
      <ul>{services.map((s) => <li><a href={`/especialidades/${s.slug}`}>{s.name}</a></li>)}</ul>
      <a href="/soluciones-mineria">Soluciones</a>
      <a href="/proyectos">Proyectos</a>
      <a href="/contacto">Contacto</a>
      <a class="btn" href={site.phoneHref}>Llamar {site.phone}</a>
    </nav>
  </div>
</header>

<script>
  const megaBtn = document.querySelector<HTMLButtonElement>(".mega-btn");
  const mega = document.getElementById("mega");
  const burger = document.querySelector<HTMLButtonElement>(".burger");
  const drawer = document.getElementById("drawer");

  const toggle = (btn: HTMLButtonElement | null, panel: HTMLElement | null, force?: boolean) => {
    if (!btn || !panel) return;
    const open = force ?? btn.getAttribute("aria-expanded") !== "true";
    btn.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
    if (panel === drawer) document.body.style.overflow = open ? "hidden" : "";
  };

  megaBtn?.addEventListener("click", () => toggle(megaBtn, mega));
  burger?.addEventListener("click", () => toggle(burger, drawer));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") { toggle(megaBtn, mega, false); toggle(burger, drawer, false); }
  });
  document.addEventListener("click", (e) => {
    const t = e.target as Node;
    if (mega && !mega.hidden && !mega.contains(t) && !megaBtn?.contains(t)) toggle(megaBtn, mega, false);
  });
</script>

<style>
  .hdr { 
    position: sticky; top: 0; z-index: 50; 
    background-color: rgb(22 99 150 / 0.95); /* Corporate Blue with opacity */
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1); 
    box-shadow: var(--shadow-sm);
    transition: var(--transition-base);
  }
  .bar { height: var(--header-h); display: flex; align-items: center; gap: 32px; }
  .nav { display: none; gap: 30px; margin-left: auto; align-items: center; }
  .nav > a, .mega-btn {
    font-family: var(--display); font-weight: 600; font-size: 1rem; text-decoration: none; color: var(--white);
    background: none; border: 0; padding: 26px 0; cursor: pointer; display: inline-flex; gap: 6px; align-items: center;
    border-bottom: 3px solid transparent; opacity: 0.9;
    transition: var(--transition-base);
  }
  .nav > a:hover, .mega-btn:hover { color: var(--white); opacity: 1; border-bottom-color: rgba(255, 255, 255, 0.5); }
  .nav > a[aria-current="page"], .mega-btn[data-active] { border-bottom-color: var(--accent); opacity: 1; }
  .mega-btn svg { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
  .mega-btn[aria-expanded="true"] svg { transform: rotate(180deg); }

  .mega { 
    position: absolute; left: 0; right: 0; top: 100%; 
    background: var(--white); 
    border-bottom: 1px solid var(--line); 
    box-shadow: var(--shadow-lg); 
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    overflow: hidden;
  }
  .mega-in { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(32px, 5vw, 64px); padding-block: 44px 52px; }
  .mega h2 { font-size: 2.2rem; color: var(--corporate-blue); }
  .mega h3 { font-size: 1.05rem; color: var(--ink); font-weight: 700; margin-bottom: 16px; }
  .mega p { color: var(--steel); font-size: 1.1rem; }
  .mega ul { list-style: none; padding: 0; margin: 0; }
  .mega li a { 
    display: block; padding: 12px 0; border-bottom: 1px solid var(--line); 
    text-decoration: none; font-weight: 500; color: var(--steel);
    transition: var(--transition-base);
  }
  .mega li a:hover { color: var(--accent); padding-left: 6px; }
  .mega li:last-child a { border-bottom: none; }

  .actions { display: flex; align-items: center; gap: 20px; margin-left: auto; }
  .tel { display: none; text-decoration: none; font-weight: 600; font-size: 0.95rem; color: var(--white); transition: opacity 0.2s; opacity: 0.9; }
  .tel:hover { opacity: 1; }
  .cta { display: none; padding: 12px 24px; font-size: 0.95rem; }

  .burger { width: 44px; height: 44px; background: none; border: 0; display: grid; place-content: center; gap: 6px; cursor: pointer; }
  .burger span { width: 24px; height: 2px; background: var(--white); display: block; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s; }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  .drawer { position: fixed; inset: var(--header-h) 0 0; background: var(--white); overflow-y: auto; padding-block: 24px 48px; }
  .drawer nav > a:not(.btn) { display: block; font-family: var(--display); font-size: 1.6rem; font-weight: 700; padding: 12px 0; text-decoration: none; border-bottom: 1px solid var(--line); color: var(--ink); }
  .drawer ul { list-style: none; margin: 0; padding: 4px 0 12px 16px; border-left: 3px solid var(--accent); }
  .drawer li a { display: block; padding: 10px 0; text-decoration: none; color: var(--steel); font-weight: 500; }
  .drawer .btn { margin-top: 32px; width: 100%; }

  @media (min-width: 1080px) {
    .nav { display: flex; }
    .actions { margin-left: 0; }
    .cta { display: inline-flex; }
    .burger { display: none; }
    .drawer { display: none; }
  }
  @media (min-width: 1280px) { .tel { display: inline; } }
</style>
