---
// Banner interior de página: imagen a todo el ancho, migas y título grande
interface Props { title: string; text?: string; image: string; alt?: string; crumbs?: { label: string; href?: string }[] }
const { title, text, image, alt = "", crumbs = [] } = Astro.props;
---
<section class="ph">
  <img src={image} alt={alt} fetchpriority="high" />
  <div class="shade"></div>
  <div class="wrap in">
    {crumbs.length > 0 && (
      <nav aria-label="Migas de pan" class="crumbs">
        <a href="/">Inicio</a>
        {crumbs.map((c) => (c.href ? <><span>/</span><a href={c.href}>{c.label}</a></> : <><span>/</span><span aria-current="page">{c.label}</span></>))}
      </nav>
    )}
    <h1>{title}</h1>
    {text && <p class="lead">{text}</p>}
    <slot />
  </div>
</section>
<style>
  .ph { position: relative; min-height: clamp(420px, 62vh, 620px); display: flex; align-items: flex-end; color: var(--white); overflow: hidden; background: var(--ink); }
  .ph > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(31,42,51,0.9) 0%, rgba(31,42,51,0.6) 55%, rgba(31,42,51,0.2) 100%); }
  .in { position: relative; padding-block: 56px clamp(48px, 7vw, 88px); }
  h1 { max-width: 20ch; }
  .lead { color: #dde3e7; max-width: 56ch; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.9rem; margin-bottom: 24px; color: #c3cbd1; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
</style>
