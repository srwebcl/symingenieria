---
// Banner interior de página: imagen a todo el ancho, migas y título grande
interface Props { title: string; text?: string; image: string; alt?: string; crumbs?: { label: string; href?: string }[] }
const { title, text, image, alt = "", crumbs = [] } = Astro.props;
---
<section class="ph">
  <img src={image} alt={alt} fetchpriority="high" />
  <div class="shade"></div>
  <div class="wrap in">
    {crumbs.length > 0 && (
      <nav aria-label="Migas de pan" class="crumbs">
        <a href="/">Inicio</a>
        {crumbs.map((c) => (c.href ? <><span>/</span><a href={c.href}>{c.label}</a></> : <><span>/</span><span aria-current="page">{c.label}</span></>))}
      </nav>
    )}
    <h1>{title}</h1>
    {text && <p class="lead">{text}</p>}
    <slot />
  </div>
</section>
<style>
  .ph { 
    position: relative; min-height: clamp(480px, 62vh, 680px); 
    display: flex; align-items: flex-end; 
    color: var(--white); overflow: hidden; background: var(--ink); 
  }
  .ph > img { 
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; 
    animation: zoomOut 1.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  .shade { 
    position: absolute; inset: 0; 
    background: linear-gradient(to top, var(--ink) 0%, rgba(15, 23, 42, 0.5) 60%, rgba(15, 23, 42, 0.1) 100%); 
  }
  .in { 
    position: relative; padding-block: 64px clamp(56px, 8vw, 104px); 
    animation: slideUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.2s both;
  }
  h1 { max-width: 22ch; color: var(--white); margin-bottom: 0.3em; }
  .lead { color: #CBD5E1; /* Slate 300 */ max-width: 60ch; }
  
  .crumbs { display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.95rem; margin-bottom: 24px; color: #94A3B8; font-weight: 500; }
  .crumbs a { text-decoration: none; transition: var(--transition-base); }
  .crumbs a:hover { color: var(--white); }
  .crumbs span[aria-current="page"] { color: var(--white); }

  @keyframes zoomOut { from { transform: scale(1.08); } to { transform: scale(1); } }
  @keyframes slideUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
</style>
