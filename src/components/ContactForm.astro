---
import { services } from "../data/services";
import { site } from "../data/site";
interface Props { preset?: string; dark?: boolean }
const { preset, dark = false } = Astro.props;
---
<form class:list={["form-premium", { dark }]} action={site.formEndpoint} method="POST">
  <input type="hidden" name="_subject" value="Nueva solicitud desde sym-ingenieria.cl" />
  
  <div class="row-premium">
    <label class="label-premium">
      <span class="label-text">Nombre completo</span>
      <input class="input-premium" name="nombre" autocomplete="name" placeholder="Ej. Juan Pérez" required />
    </label>
    <label class="label-premium">
      <span class="label-text">Empresa</span>
      <input class="input-premium" name="empresa" autocomplete="organization" placeholder="Ej. Minera Centinela" />
    </label>
  </div>
  
  <div class="row-premium">
    <label class="label-premium">
      <span class="label-text">Correo electrónico</span>
      <input class="input-premium" type="email" name="email" autocomplete="email" placeholder="juan@minera.cl" required />
    </label>
    <label class="label-premium">
      <span class="label-text">Teléfono</span>
      <input class="input-premium" type="tel" name="telefono" autocomplete="tel" placeholder="+56 9 1234 5678" />
    </label>
  </div>
  
  <label class="label-premium">
    <span class="label-text">Especialidad de interés</span>
    <div class="select-wrapper">
      <select class="input-premium" name="servicio">
        <option value="">Seleccione una especialidad</option>
        {services.map((s) => <option value={s.name} data-slug={s.slug} selected={s.slug === preset}>{s.name}</option>)}
        <option value="Otro">Otro</option>
      </select>
      <svg class="select-icon" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="2" fill="none"/></svg>
    </div>
  </label>
  
  <label class="label-premium">
    <span class="label-text">Cuéntenos sobre su proyecto</span>
    <textarea class="input-premium" name="mensaje" rows="4" placeholder="Detalles de ingeniería, plazos, etc." required></textarea>
  </label>
  
  <button class="btn-submit-premium" type="submit">Enviar solicitud de proyecto</button>
  <p class="note-premium">Respondemos en un plazo de 24 horas hábiles.</p>
</form>

<style>
  .form-premium { 
    display: grid; gap: 24px; 
    background: #FFFFFF;
    padding: clamp(32px, 5vw, 48px);
    /* Removed rounded corners and bouncy shadow to match high-end brutalism */
    border-radius: 0;
    box-shadow: none;
    border: 1px solid rgba(0,0,0,0.1); /* Subtle sharp border */
  }
  
  .row-premium { display: grid; gap: 24px; }
  @media (min-width: 600px) { .row-premium { grid-template-columns: 1fr 1fr; } }
  
  .label-premium { display: grid; gap: 8px; position: relative; }
  .label-text { 
    font-size: 0.85rem; 
    font-weight: 700; 
    text-transform: uppercase; 
    letter-spacing: 0.1em; 
    color: rgba(0,0,0,0.6); 
  }
  
  .input-premium {
    font-family: inherit; 
    font-size: 1.05rem; 
    font-weight: 400; 
    padding: 16px 20px; 
    border: 1px solid rgba(0,0,0,0.1); 
    border-radius: 0; /* Sharp edges */
    background: #F8FAFC; 
    color: #0F172A; 
    width: 100%; 
    transition: all 0.3s ease;
  }
  
  .input-premium::placeholder { color: #94A3B8; }
  
  .input-premium:hover { 
    background: #FFFFFF; 
    border-color: rgba(0,0,0,0.2); 
  }
  
  .input-premium:focus { 
    outline: none; 
    border-color: var(--corporate-blue, #0A3D62); 
    background: #FFFFFF; 
    /* Sharp bottom accent instead of bouncy ring */
    box-shadow: inset 0 -2px 0 var(--corporate-blue, #0A3D62); 
  }

  .select-wrapper { position: relative; }
  .select-wrapper select { appearance: none; padding-right: 48px; }
  .select-icon { 
    position: absolute; right: 20px; top: 50%; transform: translateY(-50%); 
    color: rgba(0,0,0,0.4); pointer-events: none; 
  }
  
  .btn-submit-premium { 
    justify-self: start;
    margin-top: 16px;
    background: var(--corporate-blue, #0A3D62);
    color: #FFFFFF;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 20px 48px;
    border: none;
    border-radius: 0; /* Sharp edges */
    cursor: pointer;
    transition: background 0.4s ease, transform 0.4s ease;
  }
  
  .btn-submit-premium:hover { 
    background: var(--text-primary);
    transform: translateY(-2px);
  }
  
  .btn-submit-premium:active {
    transform: translateY(0);
  }
  
  .note-premium { 
    font-size: 0.85rem; color: #94A3B8; margin: 0; text-align: left; 
    margin-top: 8px;
  }
  
  /* Dark mode overrides if needed */
  .dark { background: transparent; padding: 0; border: none; }
  .dark .label-text { color: rgba(255,255,255,0.6); }
  .dark .note-premium { color: rgba(255,255,255,0.5); }
  .dark .input-premium {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.1);
    color: #FFF;
  }
  .dark .input-premium:hover {
    background: rgba(255,255,255,0.1);
  }
  .dark .input-premium:focus {
    box-shadow: inset 0 -2px 0 var(--accent);
  }
</style>
