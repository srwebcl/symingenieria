---
import { services } from "../data/services";
import { site } from "../data/site";
interface Props { preset?: string; dark?: boolean }
const { preset, dark = false } = Astro.props;
---
<form class:list={["form", { dark }]} action={site.formEndpoint} method="POST">
  <input type="hidden" name="_subject" value="Nueva solicitud desde sym-ingenieria.cl" />
  <div class="row">
    <label>Nombre<input name="nombre" autocomplete="name" required /></label>
    <label>Empresa<input name="empresa" autocomplete="organization" /></label>
  </div>
  <div class="row">
    <label>Correo<input type="email" name="email" autocomplete="email" required /></label>
    <label>Teléfono<input type="tel" name="telefono" autocomplete="tel" /></label>
  </div>
  <label>Servicio
    <select name="servicio">
      <option value="">Seleccione un servicio</option>
      {services.map((s) => <option value={s.name} data-slug={s.slug} selected={s.slug === preset}>{s.name}</option>)}
      <option value="Otro">Otro</option>
    </select>
  </label>
  <label>Cuéntenos sobre su proyecto<textarea name="mensaje" rows="4" required></textarea></label>
  <button class="btn" type="submit">Enviar solicitud</button>
  <p class="note">Respondemos en un plazo de un día hábil.</p>
</form>
<style>
  .form { display: grid; gap: 18px; }
  .row { display: grid; gap: 18px; }
  @media (min-width: 640px) { .row { grid-template-columns: 1fr 1fr; } }
  label { display: grid; gap: 6px; font-weight: 600; font-size: 0.92rem; }
  input, select, textarea {
    font: inherit; font-weight: 400; padding: 13px 14px; border: 1px solid var(--line); border-radius: 4px;
    background: var(--white); color: var(--ink); width: 100%;
  }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: var(--accent); }
  .btn { justify-self: start; }
  .note { font-size: 0.85rem; color: var(--steel); margin: 0; }
  .dark label { color: var(--white); }
  .dark .note { color: #c3cbd1; }
</style>
