---
import type { Project } from "../data/site";
interface Props { items: Project[] }
const { items } = Astro.props;
---
<ul class="pg">
  {items.map((p) => (
    <li>
      <figure>
        <div class="ratio">
          {p.video ? (
            <video src={p.video} poster={p.image} autoplay loop muted playsinline />
          ) : (
            <img src={p.image} alt={p.title} loading="lazy" decoding="async" />
          )}
        </div>
        <figcaption><h3>{p.title}</h3><span>{p.client}</span></figcaption>
      </figure>
    </li>
  ))}
</ul>
<style>
  .pg { list-style: none; margin: 0; padding: 0; display: grid; gap: 40px 28px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .pg { grid-template-columns: 1fr 1fr; } }
  figure { margin: 0; }
  figcaption { padding-top: 18px; border-top: 3px solid var(--accent); margin-top: 18px; }
  h3 { margin-bottom: 4px; }
  span { color: var(--steel); }
  .section--ink span { color: #c3cbd1; }
</style>
