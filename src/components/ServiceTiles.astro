---
// Accesos rápidos a cada servicio, al estilo de los "quick tiles" corporativos
import Icon from "./Icon.astro";
import type { Service } from "../data/services";
interface Props { items: Service[] }
const { items } = Astro.props;
---
<ul class="tiles">
  {items.map((s, index) => (
    <li class={`reveal-on-scroll delay-${(index % 3) + 1}`}>
      <a href={`/especialidades/${s.slug}`} class="tile-card">
        <span class="ic"><Icon name={s.icon} size={44} /></span>
        <h3>{s.name}</h3>
        <p>{s.summary}</p>
        <span class="go"><Icon name="arrow" size={24} /></span>
      </a>
    </li>
  ))}
</ul>
<style>
  .tiles { 
    list-style: none; margin: 0; padding: 0; 
    display: grid; gap: 24px; 
    grid-template-columns: 1fr; 
  }
  @media (min-width: 700px) { .tiles { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .tiles { grid-template-columns: repeat(3, 1fr); } }
  
  .tile-card { 
    position: relative; display: flex; flex-direction: column; height: 100%; 
    padding: 40px 32px 80px; 
    background: var(--white); text-decoration: none; 
    border: 1px solid var(--line); 
    border-radius: 0; /* Sharp edges */
    box-shadow: none; /* Flat design */
    transition: background 0.4s ease, border-color 0.4s ease, transform 0.4s ease; 
  }
  
  .ic { color: var(--accent); margin-bottom: 24px; transition: color 0.4s ease, transform 0.4s ease; display: inline-block; }
  h3 { margin-bottom: 12px; transition: color 0.4s ease; font-family: var(--display); letter-spacing: -0.01em; }
  p { color: var(--steel); margin: 0; transition: color 0.4s ease; line-height: 1.5; }
  
  .go { 
    position: absolute; left: 32px; bottom: 32px; 
    color: var(--accent); opacity: 0.5;
    transition: opacity 0.4s ease, transform 0.4s ease; 
  }
  
  .tile-card:hover { 
    background: var(--corporate-blue, #0A3D62); 
    border-color: var(--corporate-blue, #0A3D62);
    transform: translateY(-4px);
  }
  .tile-card:hover h3 { color: var(--white); }
  .tile-card:hover p { color: rgba(255,255,255,0.7); }
  .tile-card:hover .ic { transform: scale(1.1); color: var(--white); }
  .tile-card:hover .go { transform: translateX(8px); opacity: 1; color: var(--white); }
</style>
