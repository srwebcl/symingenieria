---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import CtaBand from "../../components/CtaBand.astro";
import { img } from "../../data/site";
---
<Layout title="Obras civiles para minería: fundaciones, losas y muros | S&M" description="Ingeniería y construcción de fundaciones, losas, muros de contención, galpones y geomembranas HDPE y PVC para faenas mineras.">
  <PageHero
    title="Ingeniería y Construcción de Obras Civiles y Arquitectura"
    text="Diseñamos y construimos la base de su instalación minera: fundaciones, losas, muros de contención, galpones e impermeabilizaciones, desde el levantamiento en terreno hasta la entrega."
    image={img.foto1}
    crumbs={[{ label: "Especialidades", href: "/especialidades" }, { label: "Obras Civiles y Arquitectura" }]}
  >
    <div class="cta">
      <a class="btn" href="/contacto">Cotizar obra civil</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap intro">
      <div>
        <h2>La base de toda instalación minera</h2>
        <p class="lead">Cada equipo, estructura o acopio depende de una obra civil bien calculada y bien ejecutada. Desarrollamos la planimetría y las especificaciones técnicas, y construimos con control en cada etapa: excavación, enfierradura, moldaje, hormigonado y terminaciones.</p>
      </div>
      <aside class="facts" aria-label="Datos clave">
        <h3>Por qué S&M</h3>
        <ul>
          <li><strong>Ingeniería y obra en un mismo equipo:</strong> la misma empresa calcula y construye, sin traspasos entre consultora y contratista.</li>
          <li><strong>Experiencia en plantas en operación:</strong> obras ejecutadas dentro de plantas activas de ENAMI, CMP y Minera San Gerónimo.</li>
          <li><strong>Obras complementarias:</strong> podemos sumar estructuras, piping y montaje al mismo contrato.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--stone">
    <div class="wrap">
      <h2>Qué incluye esta especialidad</h2>
      <ul class="scope">
        <li>
          <span class="ic"><Icon name="check" size={26} /></span>
          <h3>Planimetría y EETT</h3>
          <p>Levantamiento en terreno, diseño e ingeniería, memorias de cálculo y documentos técnicos.</p>
        </li>
        <li>
          <span class="ic"><Icon name="check" size={26} /></span>
          <h3>Obras civiles</h3>
          <p>Fundaciones de edificios y equipos; losas, radieres y muros de contención; galpones, oficinas, salas de cambio y baños.</p>
        </li>
        <li>
          <span class="ic"><Icon name="check" size={26} /></span>
          <h3>Geomembranas</h3>
          <p>Impermeabilización con geotextil y lámina HDPE de 1 a 2 mm, e impermeabilización con PVC desde 0,75 mm.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap projects">
      <h2>Obras civiles ejecutadas</h2>
      <ul>
        <li><strong>Sostenimiento de muro de contención y cierre estructural.</strong> Excavación de 65 m³, pilares con zapata de hormigón armado (~12 t de fierro y ~100 m³ de hormigón), pantallas de shotcrete y 111 m de cierre con planchas de zinc 5V. Poder de Compra Guayacán – ENAMI, nov 2025 – feb 2026.</li>
        <li><strong>Obras de arte N°4 y N°5, camino de acceso a la dársena.</strong> Relleno compactado de ~1.290 m³; pasada de hormigón armado de 21,3 m de largo y 1,7 m de alto (34,28 m³); ducto metálico corrugado de 1 m de diámetro con brocales de hormigón armado; losa, cierre perimetral y caseta de comunicación. Puerto Cruz Grande – CMP, dic 2024 – mar 2025.</li>
        <li><strong>Losa de acopio de minerales (Cancha 0).</strong> Losa de hormigón armado de 2.034 m² (424 m³ de hormigón y 36 t de fierro), cierre perimetral mixto de 2,6 m de alto y portones de acero. Planta Delta – ENAMI, dic 2022 – abr 2023.</li>
        <li><strong>Piscina de emergencia de hormigón armado.</strong> Excavación de 273 m³, 47 m³ de hormigón y 290 m³ de capacidad para contener derrames del área de filtrado. Planta Delta – ENAMI, dic 2022 – mar 2023.</li>
        <li><strong>Galpón para sala de reactivos de flotación.</strong> Plataforma estabilizada de 102 m³ y losa de 48 m² con canaleta antiderrames. Planta Delta – ENAMI, dic 2023 – mar 2024.</li>
        <li><strong>Reposición de carpeta HDPE</strong> en el talud poniente del tranque de relaves. Planta Delta – ENAMI, nov – dic 2022.</li>
        <li><strong>Mantención de piscinas</strong> de agua recuperada, emergencia y aguas lluvias del depósito de relaves. Planta Delta – ENAMI, 2022, 2024 y 2025.</li>
      </ul>
      <a class="btn btn--ghost mt" href="/proyectos">Ver todos los proyectos</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq">
      <h2>Preguntas frecuentes</h2>
      <div>
        <details>
          <summary>¿Desarrollan la ingeniería de la obra civil o solo la construyen?</summary>
          <p>Ambas cosas. Podemos partir desde el levantamiento en terreno y las memorias de cálculo, o construir según una ingeniería existente.</p>
        </details>
        <details>
          <summary>¿Qué geomembranas instalan?</summary>
          <p>Lámina HDPE de 1 a 2 mm con geotextil y PVC desde 0,75 mm. También reparamos láminas HDPE mediante termofusión.</p>
        </details>
        <details>
          <summary>¿Trabajan dentro de plantas en operación?</summary>
          <p>Sí. Hemos construido losas, piscinas, galpones y muros en plantas activas de ENAMI y Minera San Gerónimo.</p>
        </details>
      </div>
    </div>
  </section>

  <CtaBand title="Construyamos una base sólida para su proyecto" text="Cuéntenos el alcance y le enviamos una propuesta técnica y económica." preset="Obras Civiles y Arquitectura" />
</Layout>

<style>
  .cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 28px; }
  .intro { display: grid; gap: 48px; grid-template-columns: 1fr; }
  @media (min-width: 960px) { .intro { grid-template-columns: 1.5fr 1fr; align-items: start; } }
  .facts { border-top: 6px solid var(--accent); background: var(--stone); padding: 28px; }
  .facts h3 { margin-bottom: 16px; font-size: 1.2rem; }
  .facts ul { padding-left: 20px; color: var(--steel); display: grid; gap: 12px; }
  
  .scope { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); grid-template-columns: 1fr; }
  @media (min-width: 700px) { .scope { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .scope { grid-template-columns: repeat(3, 1fr); } }
  .scope li { background: var(--white); padding: 30px 28px; }
  .scope .ic { color: var(--accent); display: block; margin-bottom: 14px; }
  .scope p { color: var(--steel); margin: 0; font-size: 0.97rem; }
  
  .projects { display: grid; gap: 32px; color: #c3cbd1; }
  .projects h2 { color: white; margin-bottom: 10px; }
  .projects ul { padding-left: 20px; display: grid; gap: 12px; font-size: 1.05rem; }
  .projects li strong { color: white; }
  .mt { margin-top: 16px; }

  .faq { display: grid; gap: 32px; grid-template-columns: 1fr; }
  @media (min-width: 960px) { .faq { grid-template-columns: 1fr 1.6fr; } }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 22px 40px 22px 0; font-family: var(--display); font-weight: 600; font-size: 1.15rem; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; position: absolute; right: 4px; top: 16px; font-size: 1.8rem; color: var(--accent); transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { color: var(--steel); padding-bottom: 20px; }
</style>
