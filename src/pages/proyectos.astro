---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { img, projects } from "../data/site";
---
<Layout title="Proyectos de ingeniería y construcción minera | S&M Ingeniería" description="Más de 30 proyectos desde 2019 para ENAMI, Minera San Gerónimo, Los Pelambres, CMP, Caserones, Minera Arqueros y CAP Minería.">
  <PageHero
    title="Proyectos ejecutados en la minería chilena"
    text="Proyectos de ingeniería, construcción, montaje, suministro, inspección y permisos desde 2019, en faenas de las regiones de Coquimbo, Atacama y Antofagasta."
    image={img.hero}
    crumbs={[{ label: "Proyectos" }]}
  />

  <section class="section project-list-section">
    <div class="wrap">
      <ul class="brutalist-list">
        {projects.map((p, i) => (
          <li class="reveal-on-scroll">
            <a href={`/proyectos/${p.slug}`} class="list-row">
              <div class="list-row-main">
                <span class="row-num">{(i+1).toString().padStart(2, '0')}</span>
                <h3 class="row-title">{p.title}</h3>
              </div>
              <div class="list-row-meta">
                <span class="row-client">{p.client}</span>
                <span class="row-arrow">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .project-list-section {
    padding-top: 48px;
    padding-bottom: clamp(64px, 8vw, 120px);
    background: #FFFFFF;
  }
  
  .brutalist-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  
  .brutalist-list li {
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }
  
  .list-row {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 16px;
    text-decoration: none;
    color: var(--ink);
    transition: all 0.3s ease;
  }
  
  @media (min-width: 900px) {
    .list-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 48px;
    }
  }
  
  .list-row-main {
    display: flex;
    gap: 24px;
    align-items: baseline;
    flex: 1;
  }
  
  .row-num {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent);
    min-width: 24px;
  }
  
  .row-title {
    font-family: var(--display);
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    margin: 0;
    line-height: 1.3;
    transition: color 0.3s;
  }
  
  .list-row-meta {
    display: flex;
    align-items: center;
    gap: 32px;
    justify-content: space-between;
  }
  
  .row-client {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(0,0,0,0.5);
    transition: color 0.3s;
  }
  
  .row-arrow {
    color: rgba(0,0,0,0.2);
    transition: transform 0.3s, color 0.3s;
  }
  
  /* Hover Effects */
  .list-row:hover {
    background: var(--stone);
    padding-left: 24px;
    padding-right: 24px;
  }
  
  .list-row:hover .row-title {
    color: var(--corporate-blue, #0A3D62);
  }
  
  .list-row:hover .row-client {
    color: var(--ink);
  }
  
  .list-row:hover .row-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }
</style>
