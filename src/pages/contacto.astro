---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
---
<Layout title="Contacto | S&M Ingeniería SpA" description="Cotice su proyecto de ingeniería con S&M Ingeniería. Oficina en La Serena y reuniones en Calama y Santiago.">
  <section class="section">
    <div class="wrap grid-2 top">
      <div>
        <h1>Contacto</h1>
        <p class="lead">Consulte por los servicios que necesita cotizar. Coordinamos una reunión con nuestros profesionales en {site.offices.join(", ")}.</p>
        <ul class="list">
          <li><Icon name="pin" size={24} /><span>{site.address}</span></li>
          <li><Icon name="phone" size={24} /><a href={site.phoneHref}>{site.phone}</a></li>
          <li><Icon name="whatsapp" size={24} /><a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><Icon name="mail" size={24} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
      <div class="box"><ContactForm /></div>
    </div>
  </section>
</Layout>
<script>
  // Preselecciona el servicio si viene en la URL: /contacto?servicio=<slug>
  const slug = new URLSearchParams(location.search).get("servicio");
  const sel = document.querySelector<HTMLSelectElement>('select[name="servicio"]');
  if (slug && sel) { const o = sel.querySelector<HTMLOptionElement>(`option[data-slug="${slug}"]`); if (o) o.selected = true; }
</script>
<style>
  .top { align-items: start; }
  .list { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 18px; }
  .list li { display: flex; gap: 14px; align-items: center; }
  .list :global(svg) { color: var(--accent); flex: none; }
  .list a { font-weight: 600; text-decoration: none; }
  .list a:hover { color: var(--accent); }
  .box { background: var(--stone); padding: clamp(24px, 4vw, 44px); border-top: 6px solid var(--accent); }
</style>
