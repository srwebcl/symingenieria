---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { img } from "../data/site";
---
<Layout title="Soluciones para plantas mineras: hierro, relaves, agua y acopios | S&M" description="Recuperación de hierro desde relaves, filtrado de relaves, recuperación de agua, protección de acopios y ampliación de capacidad de plantas.">
  <PageHero
    title="Soluciones de ingeniería para los desafíos de su planta"
    text="Analizamos el proceso en todas sus etapas y desarrollamos la solución completa: ingeniería de detalles, suministro de materiales, construcción, montaje y puesta en marcha."
    image={img.foto2}
    crumbs={[{ label: "Soluciones" }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="sols">
        <div class="sol">
          <h3>Recuperación de hierro desde relaves de concentrados de cobre</h3>
          <p>Convertimos un residuo en producto: plantas que recuperan hierro y agua desde las colas de flotación mediante concentración magnética, espesamiento, filtrado y apilamiento.</p>
          <div class="tags">
            <a href="/especialidades/obras-civiles-y-arquitectura">Obras civiles</a>
            <a href="/especialidades/estructuras-y-caldereria">Estructuras</a>
            <a href="/especialidades/montaje-mecanico-y-procesos">Montaje mecánico</a>
            <a href="/especialidades/piping">Piping</a>
            <a href="/especialidades/inspeccion-administracion-y-permisos">Administración</a>
          </div>
          <p class="ref"><strong>Referencia:</strong> Planta Talcuna (2020–2021)</p>
        </div>

        <div class="sol">
          <h3>Filtrado de relaves y recuperación de agua</h3>
          <p>Plantas de filtrado para la depositación y el manejo en seco de los relaves, con recuperación del agua de proceso.</p>
          <div class="tags">
            <a href="/especialidades/estructuras-y-caldereria">Estructuras</a>
            <a href="/especialidades/montaje-mecanico-y-procesos">Montaje mecánico</a>
            <a href="/especialidades/piping">Piping</a>
          </div>
          <p class="ref"><strong>Referencia:</strong> Minera Los Pelambres (2024–2026) · Planta Talcuna</p>
        </div>

        <div class="sol">
          <h3>Recuperación de minerales desde acopios de baja ley</h3>
          <p>Sistemas para recuperar minerales de interés desde acopios de baja ley, como plantas semimóviles de concentración magnética en seco.</p>
          <div class="tags">
            <a href="/especialidades/montaje-mecanico-y-procesos">Montaje mecánico</a>
          </div>
        </div>

        <div class="sol">
          <h3>Ampliación y mejora de la capacidad de producción</h3>
          <p>Analizamos el proceso en todas sus etapas para ampliar y mejorar la capacidad de plantas de minerales.</p>
          <div class="tags">
            <a href="/especialidades/montaje-mecanico-y-procesos">Montaje mecánico</a>
            <a href="/especialidades/piping">Piping</a>
          </div>
          <p class="ref"><strong>Referencia:</strong> Mejora de molino 9' × 12' (2022)</p>
        </div>

        <div class="sol">
          <h3>Protección ambiental de acopios</h3>
          <p>Encapsulamiento de acopios de minerales con pantallas eólicas de malla Nexport.</p>
          <div class="tags">
            <a href="/especialidades/obras-civiles-y-arquitectura">Obras civiles</a>
            <a href="/especialidades/estructuras-y-caldereria">Estructuras</a>
          </div>
        </div>

        <div class="sol">
          <h3>Conducción de concentrados, relaves y agua</h3>
          <p>Mejoramiento de la conducción por cañerías o canales abiertos, impulsada por bombas o por gravedad.</p>
          <div class="tags">
            <a href="/especialidades/piping">Piping</a>
          </div>
          <p class="ref"><strong>Referencia:</strong> Ingeniería pipeline Planta Talcuna (2025–2026)</p>
        </div>

        <div class="sol">
          <h3>Transporte de minerales secos o de baja humedad</h3>
          <p>Sistemas de transporte de minerales hasta los puntos de acopio, con correas transportadoras y stackers.</p>
          <div class="tags">
            <a href="/especialidades/estructuras-y-caldereria">Estructuras</a>
            <a href="/especialidades/montaje-mecanico-y-procesos">Montaje mecánico</a>
          </div>
          <p class="ref"><strong>Referencia:</strong> Planta Talcuna</p>
        </div>

        <div class="sol">
          <h3>Alimentadores de correas transportadoras</h3>
          <p>Implementación y mejora de alimentadores para una carga continua y controlada.</p>
          <div class="tags">
            <a href="/especialidades/estructuras-y-caldereria">Estructuras</a>
            <a href="/especialidades/montaje-mecanico-y-procesos">Montaje mecánico</a>
          </div>
          <p class="ref"><strong>Referencia:</strong> Alimentador molino 3 (2026)</p>
        </div>

        <div class="sol">
          <h3>Condiciones subestándar en plantas de proceso</h3>
          <p>Detección, evaluación y propuesta de levantamiento de condiciones subestándar.</p>
          <div class="tags">
            <a href="/especialidades/inspeccion-administracion-y-permisos">Inspección técnica</a>
          </div>
          <p class="ref"><strong>Referencia:</strong> Caserones · Planta Delta</p>
        </div>

        <div class="sol">
          <h3>Estructuras, calderería y piping para nuevos proyectos</h3>
          <p>Ingeniería y suministro de estructuras, calderería y piping.</p>
          <div class="tags">
            <a href="/especialidades/estructuras-y-caldereria">Estructuras</a>
            <a href="/especialidades/piping">Piping</a>
          </div>
          <p class="ref"><strong>Referencia:</strong> Minera Los Pelambres</p>
        </div>

        <div class="sol">
          <h3>Inspección y administración de proyectos</h3>
          <p>Inspección y administración de proyectos mineros e industriales.</p>
          <div class="tags">
            <a href="/especialidades/inspeccion-administracion-y-permisos">Inspección y Administración</a>
          </div>
          <p class="ref"><strong>Referencia:</strong> Caserones · Compañía Minera Arqueros</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="¿Su desafío no aparece aquí?" text="Cuéntenos qué problema enfrenta su planta y evaluaremos la mejor forma de resolverlo." preset="Consulta General">
    <a slot="btn" class="btn" href="/contacto">Describir mi desafío</a>
  </CtaBand>
</Layout>

<style>
  .sols { display: grid; gap: 32px; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .sols { grid-template-columns: 1fr 1fr; } }
  .sol { background: var(--line); padding: 32px; display: flex; flex-direction: column; }
  .sol h3 { margin-bottom: 12px; font-size: 1.25rem; color: var(--corporate-blue); }
  .sol p { color: var(--steel); margin-bottom: 20px; flex-grow: 1; }
  .sol .ref { font-size: 0.9rem; color: var(--steel); margin-top: 16px; margin-bottom: 0; padding-top: 16px; border-top: 1px solid #d4dce2; flex-grow: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tags a { font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 4px 12px; background: var(--white); color: var(--corporate-blue); border: 1px solid var(--corporate-blue); border-radius: 4px; transition: all 0.2s; }
  .tags a:hover { background: var(--corporate-blue); color: var(--white); }
</style>
