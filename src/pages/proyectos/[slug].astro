---
import Layout from "../../layouts/Layout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { projects } from "../../data/site";
import type { Project } from "../../data/site";

export function getStaticPaths() {
  return projects.map((project) => {
    return {
      params: { slug: project.slug },
      props: { project },
    };
  });
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---
<Layout title={`${project.title} | Proyectos S&M Ingeniería`} description={`Proyecto: ${project.title} para ${project.client}`}>
  
  <!-- Project Hero (Brutalist Edge-to-Edge) -->
  <header class="project-hero">
    <div class="hero-bg">
      <img src={project.image} alt={project.title} />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content wrap">
      <a href="/#proyectos" class="back-link">← Volver al Home</a>
      <span class="project-client">{project.client}</span>
      <h1 class="project-title">{project.title}</h1>
    </div>
  </header>

  <section class="section project-details">
    <div class="wrap project-grid">
      
      <!-- Tech Specs Sidebar -->
      <aside class="project-specs reveal-on-scroll">
        <div class="spec-block">
          <span class="spec-label">Cliente / Mandante</span>
          <strong class="spec-value">{project.client}</strong>
        </div>
        <div class="spec-block">
          <span class="spec-label">Especialidades aplicadas</span>
          <ul class="spec-list">
            {project.services.map(service => (
              <li>{service.replace(/-/g, ' ').toUpperCase()}</li>
            ))}
          </ul>
        </div>
        <div class="spec-block">
          <span class="spec-label">Estado</span>
          <strong class="spec-value">Entregado</strong>
        </div>
      </aside>

      <!-- Content Main -->
      <div class="project-body reveal-on-scroll delay-1">
        <p class="lead">S&M Ingeniería ejecutó este proyecto cumpliendo con los más altos estándares de calidad y seguridad exigidos por la industria minera, demostrando nuestra capacidad técnica en la resolución de problemas complejos.</p>
        
        <h2>Descripción de la obra</h2>
        <p>El proyecto "{project.title}" desarrollado para {project.client} consistió en la ejecución y gestión de especialidades críticas. Nuestro equipo lideró el proceso desde la planificación hasta el desarrollo en terreno, garantizando continuidad operacional y optimización de recursos.</p>
        
      </div>

    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .project-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    padding-bottom: 64px;
    background: #000;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(80%) contrast(1.1);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(22, 99, 150, 0.9) 0%, rgba(0,0,0,0.4) 100%);
    mix-blend-mode: multiply;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    color: #FFF;
    width: 100%;
  }

  .back-link {
    display: inline-block;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 40px;
    transition: color 0.2s;
  }
  .back-link:hover { color: #FFF; }

  .project-client {
    display: block;
    font-family: var(--body);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent); /* Corporate Red */
    margin-bottom: 16px;
  }

  .project-title {
    font-family: var(--display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
    margin: 0;
    color: #FFF;
    max-width: 20ch;
  }

  /* Grid Layout */
  .project-details {
    background: var(--bg-page, #FFF);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 64px;
    padding-top: 32px; /* Reduced white space */
    padding-bottom: 64px;
  }

  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: 1fr 2fr;
      gap: 120px;
    }
  }

  /* Specs Sidebar */
  .project-specs {
    border-top: 2px solid var(--text-primary, #000);
    padding-top: 32px;
  }

  .spec-block {
    margin-bottom: 40px;
  }

  .spec-label {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--text-secondary, #4A4A4A);
    margin-bottom: 8px;
  }

  .spec-value {
    font-family: var(--display);
    font-size: 1.4rem;
    color: var(--text-primary, #000);
  }

  .spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .spec-list li {
    font-family: var(--display);
    font-size: 1.2rem;
    color: var(--text-primary, #000);
    padding: 12px 0;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }
  .spec-list li:last-child {
    border-bottom: none;
  }

  /* Body Content */
  .project-body h2 {
    font-size: 2.2rem;
    margin-top: 48px;
    margin-bottom: 24px;
  }

  .project-body p {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-secondary, #4A4A4A);
    margin-bottom: 24px;
    max-width: 75ch;
  }

  .project-body .lead {
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--text-primary, #000);
    font-weight: 500;
    margin-bottom: 48px;
  }


</style>
