---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ServiceTiles from "../components/ServiceTiles.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/services";
import { img, projects, site } from "../data/site";

const values = [
  { title: "Compromiso", text: "Un equipo profesional responsable y disciplinado, que entrega los proyectos de ingeniería a tiempo y con altos estándares de calidad." },
  { title: "Tenacidad", text: "Esfuerzo constante para cumplir de forma eficiente los objetivos de la empresa y los de cada cliente en sus proyectos." },
  { title: "Adaptabilidad", text: "Los mercados cambian. Integramos nuevos procesos y tecnologías para responder con dinamismo a cada proyecto." },
];
---
<Layout title="S&M Ingeniería SpA | Ingeniería, construcción y montaje minero">
  <!-- Hero a pantalla completa -->
  <section class="hero">
    <img src={img.hero} alt="Instalación industrial en faena minera" fetchpriority="high" />
    <div class="shade"></div>
    <div class="wrap hero-in">
      <div class="hero-content">
        <h1>Ingeniería para la minería que se resuelve en terreno.</h1>
        <p>Ingeniería, suministro, construcción y montaje para plantas mineras e industriales. Proyectos Greenfield y Brownfield desde La Serena.</p>
        <div class="hero-cta">
          <a class="btn" href="/contacto">Cotizar un proyecto</a>
          <a class="btn btn--ghost" href="/especialidades">Ver especialidades</a>
        </div>
      </div>
    </div>
    <a class="scroll" href="#intro" aria-label="Bajar a la presentación"><Icon name="down" size={26} /></a>
  </section>

  <!-- Presentación -->
  <section class="section" id="intro">
    <div class="wrap grid-2">
      <div>
        <h2>Un solo equipo desde el diseño hasta la obra</h2>
        <p class="lead">Desarrollamos ingeniería conceptual, básica y de detalle, gestionamos el abastecimiento y conducimos la construcción de proyectos mineros e industriales.</p>
        <p>Nuestros profesionales suman más de 15 años de experiencia en las especialidades de obras civiles, estructuras, montaje, piping e inspección. Trabajamos sin grandes estructuras administrativas, lo que mantiene bajo el costo para nuestros clientes.</p>
        <a class="more" href="/nosotros"><span class="dot"><Icon name="arrow" size={18} /></span>Conozca a S&M Ingeniería</a>
      </div>
      <div class="ratio"><img src={img.foto2} alt="Equipo de S&M Ingeniería en terreno" loading="lazy" /></div>
    </div>
  </section>

  <!-- Cita / misión -->
  <section class="section section--stone">
    <div class="wrap quote">
      <span class="q"><Icon name="quote" size={56} /></span>
      <blockquote>
        <p>Entregamos soluciones de ingeniería, construcción y gestión de proyectos con un alto nivel de calidad y especialización para la minería e industria del centro-norte de Chile.</p>
        <footer>Nuestra misión</footer>
      </blockquote>
    </div>
  </section>

  <!-- Especialidades -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>Especialidades</h2>
        <a class="more" href="/especialidades"><span class="dot"><Icon name="arrow" size={18} /></span>Todas las especialidades</a>
      </div>
      <ServiceTiles items={services} />
    </div>
  </section>

  <!-- Proyectos -->
  <section class="section section--ink">
    <div class="wrap">
      <div class="head head--dark">
        <h2>Proyectos destacados</h2>
        <a class="more" href="/proyectos"><span class="dot"><Icon name="arrow" size={18} /></span>Ver más proyectos</a>
      </div>
      <ProjectGrid items={projects} />
    </div>
  </section>

  <!-- Por qué nosotros -->
  <section class="section section--stone">
    <div class="wrap">
      <h2>¿Por qué trabajar con nosotros?</h2>
      <ul class="values">
        {values.map((v) => <li><h3>{v.title}</h3><p>{v.text}</p></li>)}
      </ul>
      <p class="offices">Profesionales directamente en terreno y reuniones en {site.offices.join(", ")}.</p>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .hero { 
    position: relative; min-height: calc(100svh - var(--header-h)); 
    display: flex; align-items: flex-end; color: var(--white); background: var(--ink); overflow: hidden; 
  }
  .hero > img { 
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; 
    animation: settle 2s cubic-bezier(0.4, 0, 0.2, 1) both; 
  }
  .hero .shade { 
    position: absolute; inset: 0; 
    background: linear-gradient(to top, var(--ink) 0%, rgba(15, 23, 42, 0.6) 50%, rgba(15, 23, 42, 0.2) 100%); 
  }
  .hero-in { position: relative; padding-block: 80px clamp(72px, 10vw, 120px); }
  
  .hero-content {
    animation: slideUp 1s cubic-bezier(0.4, 0, 0.2, 1) 0.3s both;
  }
  
  .hero h1 { font-size: clamp(2.6rem, 6vw, 4.8rem); font-weight: 700; font-stretch: normal; max-width: 20ch; line-height: 1.1; margin-bottom: 0.2em; color: var(--white); }
  .hero p { font-size: clamp(1.1rem, 1.5vw, 1.35rem); font-weight: 400; color: #CBD5E1; max-width: 44ch; margin-top: 16px; line-height: 1.6; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
  .scroll { 
    position: absolute; right: var(--gut); bottom: 36px; width: 56px; height: 56px; border-radius: 50%; 
    border: 2px solid rgba(255,255,255,0.4); display: grid; place-items: center; color: var(--white); 
    transition: var(--transition-base);
  }
  .scroll:hover { border-color: var(--accent); background: var(--accent); transform: translateY(4px); }
  
  @keyframes settle { from { transform: scale(1.08); } to { transform: scale(1); } }
  @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

  .quote { display: grid; gap: 24px; grid-template-columns: 1fr; max-width: 1000px; }
  @media (min-width: 800px) { .quote { grid-template-columns: 80px 1fr; } }
  .q { color: var(--accent); }
  blockquote { margin: 0; }
  blockquote p { font-family: var(--display); font-stretch: 108%; font-weight: 500; font-size: clamp(1.5rem, 2.8vw, 2.3rem); line-height: 1.25; max-width: 32ch; }
  blockquote footer { font-weight: 600; color: var(--steel); margin-top: 10px; }

  .head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 44px; }
  .head h2 { margin: 0; }
  .head--dark h2 { color: white; }
  .head--dark .more { color: #a4afb8; }
  .head--dark .more:hover { color: white; }

  .values { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 28px; grid-template-columns: 1fr; }
  @media (min-width: 800px) { .values { grid-template-columns: repeat(3, 1fr); } }
  .values li { border-top: 4px solid var(--accent); padding-top: 22px; }
  .values p { color: var(--steel); }
  .offices { margin-top: 32px; font-weight: 600; }
</style>
