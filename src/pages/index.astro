---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ServiceTiles from "../components/ServiceTiles.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/services";
import { img, projects, site } from "../data/site";

const values = [
  { title: "Compromiso", text: "Un equipo profesional responsable y disciplinado, que entrega los proyectos de ingeniería a tiempo y con altos estándares de calidad." },
  { title: "Tenacidad", text: "Esfuerzo constante para cumplir de forma eficiente los objetivos de la empresa y los de cada cliente en sus proyectos." },
  { title: "Adaptabilidad", text: "Los mercados cambian. Integramos nuevos procesos y tecnologías para responder con dinamismo a cada proyecto." },
];
---
<Layout title="S&M Ingeniería SpA | Ingeniería, construcción y montaje minero">
  
  <!-- Hero Radical -->
  <section class="hero-radical">
    <div class="hero-bg">
      <video src="/videos/crane.mp4" autoplay loop muted playsinline fetchpriority="high"></video>
    </div>
    <div class="hero-content">
      <h1 class="hero-title">Ingeniería y Construcción para la <strong>Minería</strong> en Chile.</h1>
      <div class="hero-bottom-bar">
        <p class="hero-subtitle">Ingeniería, suministro, construcción y montaje para plantas mineras e industriales.</p>
        <div class="hero-actions">
          <a class="btn-solid-radical" href="/contacto">Cotizar un proyecto</a>
          <a class="btn-outline-radical" href="#especialidades">
            Ver especialidades
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Especialidades -->
  <section class="section-radical" id="especialidades">
    <div class="header-radical reveal-on-scroll">
      <div class="header-radical-text">
        <span class="eyebrow-radical">Capacidades</span>
        <h2 class="title-section">Especialidades</h2>
      </div>
      <a class="link-radical" href="/especialidades">Todas las especialidades</a>
    </div>
    <div class="tiles-wrapper">
      <ServiceTiles items={services} />
    </div>
  </section>

  <!-- Presentación e Integración de Clientes -->
  <section class="section-radical" id="intro">
    
    <h2 class="brief-title reveal-on-scroll delay-1">Un solo equipo desde el diseño hasta la obra.</h2>

    <div class="brief-grid reveal-on-scroll delay-2">
      <div class="brief-col align-right">
        <p class="brief-text">Desarrollamos ingeniería conceptual, básica y de detalle, gestionamos el abastecimiento y conducimos la construcción de proyectos mineros e industriales.</p>
      </div>

      <div class="brief-col divider-col align-left">
        <p class="brief-text">Nuestros profesionales suman más de 15 años de experiencia en las especialidades de obras civiles, estructuras, montaje, piping e inspección.</p>
      </div>
    </div>

    <!-- Ticker de Clientes Integrado -->
    <div class="clients-section reveal-on-scroll delay-3">
      <p class="clients-eyebrow">Han confiado en nosotros</p>
      <div class="client-ticker">
        <div class="ticker-track">
          <div class="ticker-content">
            <img class="client-logo" src="/img/logos/logo-mlp.svg" alt="Minera Los Pelambres" />
            <img class="client-logo" src="/img/logos/CAP_logo.svg.webp" alt="CAP" />
            <img class="client-logo" src="/img/logos/enami.jpg" alt="ENAMI" />
            <img class="client-logo" src="/img/logos/caserones.png" alt="Caserones" />
            <img class="client-logo" src="/img/logos/san-geronimo.png" alt="Minera San Gerónimo" />
            <img class="client-logo" src="/img/logos/arqueros.png" alt="Minera Arqueros" />
          </div>
          <div class="ticker-content" aria-hidden="true">
            <img class="client-logo" src="/img/logos/logo-mlp.svg" alt="Minera Los Pelambres" />
            <img class="client-logo" src="/img/logos/CAP_logo.svg.webp" alt="CAP" />
            <img class="client-logo" src="/img/logos/enami.jpg" alt="ENAMI" />
            <img class="client-logo" src="/img/logos/caserones.png" alt="Caserones" />
            <img class="client-logo" src="/img/logos/san-geronimo.png" alt="Minera San Gerónimo" />
            <img class="client-logo" src="/img/logos/arqueros.png" alt="Minera Arqueros" />
          </div>
        </div>
      </div>
    </div>

    <div class="brief-footer reveal-on-scroll delay-4">
      <a class="btn-solid-radical btn-hover-red" href="/nosotros">Conozca a S&M Ingeniería</a>
    </div>

  </section>

  <!-- Cita / misión -->
  <section class="section-radical bg-corporate-radical">
    <div class="quote-container">
      <blockquote>
        <p class="reveal-on-scroll delay-1">Entregamos soluciones de ingeniería, construcción y gestión de proyectos con un alto nivel de calidad y especialización para la minería e industria del centro-norte de Chile.</p>
        <footer class="reveal-on-scroll delay-2">Nuestra misión</footer>
      </blockquote>
    </div>
  </section>

  </section>


  <!-- Proyectos -->
  <section class="section-radical" id="proyectos">
    <div class="header-radical reveal-on-scroll">
      <div class="header-radical-text">
        <span class="eyebrow-radical">Casos de Éxito</span>
        <h2 class="title-section">Proyectos destacados</h2>
      </div>
      <a class="link-radical" href="/proyectos">Ver más proyectos</a>
    </div>
    <div class="tiles-wrapper">
      <ProjectGrid items={projects.slice(0, 4)} />
    </div>
  </section>

  <!-- Por qué nosotros -->
  <section class="section-radical border-top-radical">
    <div class="header-radical reveal-on-scroll">
      <div class="header-radical-text">
        <span class="eyebrow-radical">Excelencia Operacional</span>
        <h2 class="title-section">¿Por qué trabajar con nosotros?</h2>
      </div>
    </div>
    <div class="values-grid">
      {values.map((v, index) => (
        <div class="value-block reveal-on-scroll">
          <span class="value-number">0{index + 1}</span>
          <h3>{v.title}</h3>
          <p>{v.text}</p>
        </div>
      ))}
    </div>
    <div class="cta-territorial reveal-on-scroll">
      <div class="cta-territorial-content">
        <span class="cta-eyebrow">Presencia Territorial</span>
        <p class="cta-text">Profesionales directamente en terreno y reuniones operativas en <strong>{site.offices.join(", ")}</strong>.</p>
      </div>
      <div class="cta-territorial-action">
        <a href="#cotizar" class="btn-cta-white">
          Conversar sobre tu proyecto
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  /* Base Variables for Radical Engineering Aesthetic */
  :root {
    --text-primary: #000000;
    --text-secondary: #4A4A4A;
    --bg-page: #FFFFFF;
    --bg-dark: #111111;
    --accent: #911B22; /* Original Logo Red */
    --corporate-blue: #0A3D62; /* Kept for brand consistency, but used as solid block */
    --concrete: #F4F4F4;
    --border-hard: #000000;
  }

  /* Reset layout constraints for this page */
  .section-radical {
    /* Tighter, denser padding like a blueprint */
    padding: clamp(48px, 6vw, 96px) clamp(20px, 4vw, 60px);
    background: var(--bg-page);
    position: relative;
  }
  
  .bg-dark-radical { background: var(--bg-dark); color: #FFF; }
  .bg-black-radical { background: #000; color: #FFF; }
  .bg-corporate-radical { background: var(--corporate-blue); color: #FFF; }
  .border-top-radical { }

  /* --- HERO RADICAL --- */
  .hero-radical {
    height: 100vh; /* Full viewport force */
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centered to prevent overflow */
    padding-top: calc(var(--header-h, 80px) + 10vh); /* Push down further */
    background: #000;
  }
  
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }
  .hero-bg video {
    width: 100%; height: 100%; object-fit: cover;
    animation: scaleIn 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Darken bottom and left heavily where text lives, fade towards top right */
    background: linear-gradient(to top right, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 50%, rgba(0,0,0,0.2) 100%);
    pointer-events: none;
  }
  
  .hero-content {
    position: relative;
    z-index: 10;
    padding: clamp(20px, 4vw, 60px);
    display: flex;
    flex-direction: column;
    gap: 32px; /* Slightly tighter gap */
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    opacity: 0;
    animation: revealUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  /* --- CLIENT TICKER INTEGRATED --- */
  .clients-section {
    margin-top: clamp(64px, 8vw, 96px); /* Replaces padding since it's now inside the section */
    width: 100%;
  }
  .clients-eyebrow {
    display: block;
    width: 100%;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-secondary);
    margin: 0 auto 24px auto;
  }
  
  .client-ticker {
    padding: 24px 0 48px 0;
    overflow: hidden;
    position: relative;
  }
  .client-ticker::before, .client-ticker::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 10vw;
    z-index: 2;
    pointer-events: none;
  }
  .client-ticker::before {
    left: 0;
    background: linear-gradient(to right, #FFFFFF, transparent);
  }
  .client-ticker::after {
    right: 0;
    background: linear-gradient(to left, #FFFFFF, transparent);
  }
  
  .ticker-track {
    display: flex;
    width: max-content;
    animation: scrollTicker 40s linear infinite;
  }
  .ticker-track:hover {
    animation-play-state: paused;
  }
  .ticker-content {
    display: flex;
    align-items: center;
    gap: 80px; 
    padding-right: 80px;
  }
  
  .client-logo {
    height: 48px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    mix-blend-mode: multiply; /* Removes white backgrounds from jpgs */
  }
  .client-logo:hover { 
    transform: scale(1.05);
  }

  @keyframes scrollTicker {
    to { transform: translateX(-50%); }
  }

  @keyframes scaleIn {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }
  @keyframes revealUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-title {
    font-family: var(--display);
    font-size: clamp(2.2rem, 4vw, 4rem); /* Refined, slightly smaller */
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    max-width: 20ch;
    margin: 0;
  }
  .hero-title strong {
    color: #FF3B30; /* Vibrant high-vis red so it pops on dark video */
  }

  .hero-bottom-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px; /* Tighter gap */
    padding-top: 24px; /* Tighter padding */
    width: 100%;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    color: #FFFFFF;
    max-width: 40ch;
    margin: 0;
    line-height: 1.4;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-solid-radical {
    background: var(--corporate-blue, #0A3D62);
    color: #FFF;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 16px 40px;
    text-decoration: none;
    transition: background 0.3s, border-color 0.3s, color 0.3s;
    border: 2px solid var(--corporate-blue, #0A3D62);
    text-align: center;
  }
  .btn-solid-radical:hover { background: #FFF; color: var(--corporate-blue, #0A3D62); border-color: #FFF; }
  
  /* Specific Red Hover Modifier */
  .btn-hover-red:hover {
    background: var(--accent) !important;
    border-color: var(--accent) !important;
    color: #FFF !important;
  }

  .btn-outline-radical {
    background: transparent;
    color: #FFF;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 16px 32px;
    text-decoration: none;
    border: 2px solid #FFF;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .btn-outline-radical svg {
    transition: transform 0.3s;
  }
  .btn-outline-radical:hover { 
    background: var(--accent); 
    border-color: var(--accent); 
    color: #FFF; 
  }
  .btn-outline-radical:hover svg {
    transform: translateY(4px);
  }

  /* --- TYPOGRAPHY & STRUCTURE --- */
  .title-section {
    font-family: var(--display);
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* Editorial Brief Layout for Intro */
  .brief-title {
    font-family: var(--display);
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-align: center;
    margin: 0 auto 48px auto;
    max-width: 22ch;
  }

  .brief-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 1200px;
    margin: 48px auto 0 auto;
  }
  
  @media (min-width: 768px) {
    .brief-grid {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
    .divider-col {
      border-left: 1px solid rgba(0,0,0,0.2);
      padding-left: 80px;
    }
  }

  .brief-footer {
    display: flex;
    justify-content: center;
    margin-top: 64px;
    width: 100%;
  }

  .grid-radical {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 1024px) {
    .grid-radical {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }

  .lead-radical {
    font-size: clamp(1.4rem, 2.5vw, 2.2rem);
    line-height: 1.25;
    font-weight: 500;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .brief-text {
    font-size: 1.15rem;
    line-height: 1.6;
    font-weight: 400;
    color: var(--text-secondary);
    margin: 0;
  }
  .align-right { text-align: right; }
  .align-left { text-align: left; }
  
  .body-radical {
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  .btn-solid-dark {
    display: inline-block;
    background: var(--text-primary);
    color: var(--bg-page);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 16px 32px;
    text-decoration: none;
    border: 2px solid var(--text-primary);
    transition: background 0.2s, color 0.2s;
  }
  .btn-solid-dark:hover { 
    background: var(--bg-page); 
    color: var(--text-primary); 
  }

  .mt-12 { margin-top: 40px; }
  
  /* --- SCROLL REVEAL EFFECTS --- */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-on-scroll.delay-1 { transition-delay: 0.1s; }
  .reveal-on-scroll.delay-2 { transition-delay: 0.2s; }
  .reveal-on-scroll.delay-3 { transition-delay: 0.3s; }
  
  .reveal-on-scroll.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- QUOTE SECTION --- */
  .quote-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  .quote-container blockquote {
    margin: 0;
  }
  .quote-container p {
    font-family: var(--display);
    font-size: clamp(1.4rem, 2vw, 2.2rem); /* Reduced from 3.5rem to be more readable */
    line-height: 1.4;
    font-weight: 300;
    margin-bottom: 24px;
  }
  .quote-container footer {
    display: block;
    font-family: var(--body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.7);
  }

  /* --- HEADER RADICAL --- */
  .header-radical {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px; /* Reduced gap */
    margin-bottom: 48px; /* Tighter margin (was 80) */
    padding-bottom: 24px; /* Tighter padding (was 40) */
  }
  .bg-black-radical .header-radical {
  }
  .header-radical-text {
    max-width: 800px;
  }

  .tiles-wrapper {
    /* Removing standard wrap margins, letting it bleed */
    width: 100%;
  }


  /* --- VALUES GRID --- */
  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .values-grid { grid-template-columns: repeat(3, 1fr); gap: 32px; }
  }
  
  .value-block {
    padding: 64px 40px;
    display: flex;
    flex-direction: column;
    transition: background 0.4s, color 0.4s, transform 0.4s;
    background: var(--stone, #F8FAFC);
  }
  
  .value-number {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 700;
    color: rgba(0,0,0,0.2);
    margin-bottom: 48px;
    transition: color 0.4s;
  }
  
  .value-block h3 {
    font-family: var(--display);
    font-size: clamp(1.8rem, 2.5vw, 2.2rem);
    font-weight: 400;
    margin-bottom: 20px;
    color: var(--accent);
    transition: color 0.4s;
  }
  
  .value-block p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    transition: color 0.4s;
    margin: 0;
  }

  /* Value Block Hover Effect */
  @media (hover: hover) {
    .value-block:hover {
      background: var(--corporate-blue, #0A3D62);
    }
    .value-block:hover .value-number {
      color: rgba(255,255,255,0.4);
    }
    .value-block:hover h3 {
      color: var(--bg-page);
    }
    .value-block:hover p {
      color: rgba(255,255,255,0.8);
    }
  }

  /* --- CTA Territorial --- */
  .cta-territorial {
    margin-top: 64px;
    background: var(--corporate-blue, #0A3D62);
    padding: clamp(48px, 6vw, 80px) clamp(32px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  
  @media (min-width: 992px) {
    .cta-territorial {
      flex-direction: row;
      align-items: center; /* Center aligns the button with the text block vertically */
      justify-content: space-between;
      gap: 64px;
    }
  }
  
  .cta-territorial-content {
    flex: 1;
    max-width: 800px;
  }
  
  .cta-eyebrow {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 24px;
  }
  
  .cta-text {
    font-family: var(--display);
    font-size: clamp(1.4rem, 2vw, 2rem);
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.01em;
    color: #FFF;
  }
  
  .cta-text strong {
    color: #FFF;
    border-bottom: 2px solid rgba(255, 255, 255, 0.3);
  }

  .cta-territorial-action {
    flex-shrink: 0;
  }

  .btn-cta-white {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #FFF;
    color: var(--corporate-blue, #0A3D62);
    padding: 20px 40px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.4s ease, transform 0.4s ease;
  }

  .btn-cta-white svg {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .btn-cta-white:hover {
      background: var(--stone, #F8FAFC);
      transform: translateY(-2px);
    }
    .btn-cta-white:hover svg {
      transform: translateX(4px);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Scroll Reveal Logic (Intersection Observer)
    const observerOptions = {
      root: null,
      rootMargin: "0px 0px -100px 0px", // Trigger slightly before it hits bottom
      threshold: 0.1
    };

    const scrollObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target); // Run once
        }
      });
    }, observerOptions);

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      scrollObserver.observe(el);
    });
  });
</script>
