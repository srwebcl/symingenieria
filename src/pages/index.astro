---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ServiceTiles from "../components/ServiceTiles.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/services";
import { img, projects, site } from "../data/site";

const values = [
  { title: "Compromiso", text: "Un equipo profesional responsable y disciplinado, que entrega los proyectos de ingeniería a tiempo y con altos estándares de calidad." },
  { title: "Tenacidad", text: "Esfuerzo constante para cumplir de forma eficiente los objetivos de la empresa y los de cada cliente en sus proyectos." },
  { title: "Adaptabilidad", text: "Los mercados cambian. Integramos nuevos procesos y tecnologías para responder con dinamismo a cada proyecto." },
];
---
<Layout title="S&M Ingeniería SpA | Ingeniería, construcción y montaje minero">
  
  <!-- Hero Radical -->
  <section class="hero-radical">
    <div class="hero-bg">
      <video src="/videos/crane.mp4" autoplay loop muted playsinline fetchpriority="high"></video>
    </div>
    <div class="hero-content">
      <h1 class="hero-title">Ingeniería y Construcción para la <strong>Minería</strong> en Chile.</h1>
      <div class="hero-bottom-bar">
        <p class="hero-subtitle">Ingeniería, suministro, construcción y montaje para plantas mineras e industriales.</p>
        <div class="hero-actions">
          <a class="btn-solid-radical" href="/contacto">Cotizar un proyecto</a>
          <a class="btn-outline-radical" href="/especialidades">Ver especialidades</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Ticker de Clientes (Infinite Scroll) -->
  <div class="client-ticker reveal-on-scroll delay-1">
    <div class="ticker-track">
      <div class="ticker-content">
        <img class="client-logo" src="/img/logos/logo-mlp.svg" alt="Minera Los Pelambres" />
        <img class="client-logo" src="/img/logos/CAP_logo.svg.webp" alt="CAP" />
        <img class="client-logo" src="/img/logos/enami.jpg" alt="ENAMI" />
        <img class="client-logo" src="/img/logos/caserones.png" alt="Caserones" />
        <img class="client-logo" src="/img/logos/san-geronimo.png" alt="Minera San Gerónimo" />
        <img class="client-logo" src="/img/logos/arqueros.png" alt="Minera Arqueros" />
      </div>
      <div class="ticker-content" aria-hidden="true">
        <img class="client-logo" src="/img/logos/logo-mlp.svg" alt="Minera Los Pelambres" />
        <img class="client-logo" src="/img/logos/CAP_logo.svg.webp" alt="CAP" />
        <img class="client-logo" src="/img/logos/enami.jpg" alt="ENAMI" />
        <img class="client-logo" src="/img/logos/caserones.png" alt="Caserones" />
        <img class="client-logo" src="/img/logos/san-geronimo.png" alt="Minera San Gerónimo" />
        <img class="client-logo" src="/img/logos/arqueros.png" alt="Minera Arqueros" />
      </div>
    </div>
  </div>

  <!-- Presentación (Manifesto Layout) -->
  <section class="section-radical" id="intro">
    <div class="manifesto-layout">
      <h2 class="title-massive manifesto-title">Un solo equipo desde el diseño hasta la obra.</h2>
      
      <div class="manifesto-lead reveal-on-scroll delay-1">
        <p class="lead-radical">Desarrollamos ingeniería conceptual, básica y de detalle, gestionamos el abastecimiento y conducimos la construcción de proyectos mineros e industriales.</p>
        <div class="mt-12">
          <a class="btn-solid-dark" href="/nosotros">Conozca a S&M Ingeniería</a>
        </div>
      </div>

      <div class="manifesto-body reveal-on-scroll delay-2">
        <p class="body-radical">Nuestros profesionales suman más de 15 años de experiencia en las especialidades de obras civiles, estructuras, montaje, piping e inspección. Trabajamos sin grandes estructuras administrativas, lo que mantiene bajo el costo para nuestros clientes.</p>
      </div>
    </div>
    <div class="full-width-image image-reveal reveal-on-scroll delay-3">
      <img src={img.foto2} alt="Equipo de S&M Ingeniería en terreno" loading="lazy" />
    </div>
  </section>

  <!-- Cita / misión -->
  <section class="section-radical bg-dark-radical">
    <div class="quote-container">
      <blockquote>
        <p>Entregamos soluciones de ingeniería, construcción y gestión de proyectos con un alto nivel de calidad y especialización para la minería e industria del centro-norte de Chile.</p>
        <footer>Nuestra misión</footer>
      </blockquote>
    </div>
  </section>

  <!-- Especialidades -->
  <section class="section-radical">
    <div class="header-radical">
      <div class="header-radical-text">
        <span class="eyebrow-radical">Capacidades</span>
        <h2 class="title-section">Especialidades</h2>
      </div>
      <a class="link-radical" href="/especialidades">Todas las especialidades</a>
    </div>
    <div class="tiles-wrapper">
      <ServiceTiles items={services} />
    </div>
  </section>

  <!-- Procesos Críticos (Slider Interactivo) -->
  <section class="section-radical bg-black-radical">
    <div class="header-radical">
      <div class="header-radical-text">
        <span class="eyebrow-radical eyebrow-light">Ejecución en Terreno</span>
        <h2 class="title-section text-white">Capacidad técnica en procesos críticos</h2>
      </div>
    </div>
    
    <div class="slider-container">
      <button class="slider-btn prev-btn" aria-label="Proceso Anterior">
        <div class="arrow-icon"></div>
      </button>
      
      <div class="slider-track" id="procesos-slider">
        <div class="slider-slide">
          <div class="video-card">
            <video src="/videos/filtro.mp4" autoplay loop muted playsinline></video>
            <div class="video-label">Filtro de Concentrado</div>
          </div>
        </div>
        <div class="slider-slide">
          <div class="video-card">
            <video src="/videos/magnetica.mp4" autoplay loop muted playsinline></video>
            <div class="video-label">Separación Magnética</div>
          </div>
        </div>
      </div>
      
      <button class="slider-btn next-btn" aria-label="Siguiente Proceso">
        <div class="arrow-icon"></div>
      </button>
    </div>
  </section>

  <!-- Proyectos -->
  <section class="section-radical">
    <div class="header-radical">
      <div class="header-radical-text">
        <span class="eyebrow-radical">Casos de Éxito</span>
        <h2 class="title-section">Proyectos destacados</h2>
      </div>
      <a class="link-radical" href="/proyectos">Ver más proyectos</a>
    </div>
    <div class="tiles-wrapper">
      <ProjectGrid items={projects} />
    </div>
  </section>

  <!-- Por qué nosotros -->
  <section class="section-radical border-top-radical">
    <div class="header-radical">
      <div class="header-radical-text">
        <span class="eyebrow-radical">Excelencia Operacional</span>
        <h2 class="title-section">¿Por qué trabajar con nosotros?</h2>
      </div>
    </div>
    <div class="values-grid">
      {values.map((v) => (
        <div class="value-block">
          <h3>{v.title}</h3>
          <p>{v.text}</p>
        </div>
      ))}
    </div>
    <div class="offices-radical">
      <p>Profesionales directamente en terreno y reuniones en <strong>{site.offices.join(", ")}</strong>.</p>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  /* Base Variables for Radical Engineering Aesthetic */
  :root {
    --text-primary: #000000;
    --text-secondary: #4A4A4A;
    --bg-page: #FFFFFF;
    --bg-dark: #111111;
    --accent: #911B22; /* Original Logo Red */
    --corporate-blue: #0A3D62; /* Kept for brand consistency, but used as solid block */
    --concrete: #F4F4F4;
    --border-hard: #000000;
  }

  /* Reset layout constraints for this page */
  .section-radical {
    /* Tighter, denser padding like a blueprint */
    padding: clamp(48px, 6vw, 96px) clamp(20px, 4vw, 60px);
    background: var(--bg-page);
    position: relative;
  }
  
  .bg-dark-radical { background: var(--bg-dark); color: #FFF; }
  .bg-black-radical { background: #000; color: #FFF; }
  .border-top-radical { border-top: 2px solid var(--text-primary); }

  /* --- HERO RADICAL --- */
  .hero-radical {
    height: 100vh; /* Full viewport force */
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centered to prevent overflow */
    padding-top: calc(var(--header-h, 80px) + 10vh); /* Push down further */
    background: #000;
  }
  
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }
  .hero-bg video {
    width: 100%; height: 100%; object-fit: cover;
    animation: scaleIn 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Darken bottom and left heavily where text lives, fade towards top right */
    background: linear-gradient(to top right, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 50%, rgba(0,0,0,0.2) 100%);
    pointer-events: none;
  }
  
  .hero-content {
    position: relative;
    z-index: 10;
    padding: clamp(20px, 4vw, 60px);
    display: flex;
    flex-direction: column;
    gap: 32px; /* Slightly tighter gap */
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    opacity: 0;
    animation: revealUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  /* --- CLIENT TICKER --- */
  .client-ticker {
    background: #FFFFFF;
    padding: 32px 0;
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .client-ticker::before, .client-ticker::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 10vw;
    z-index: 2;
    pointer-events: none;
  }
  .client-ticker::before {
    left: 0;
    background: linear-gradient(to right, #FFFFFF, transparent);
  }
  .client-ticker::after {
    right: 0;
    background: linear-gradient(to left, #FFFFFF, transparent);
  }
  
  .ticker-track {
    display: flex;
    width: max-content;
    animation: scrollTicker 40s linear infinite;
  }
  .ticker-track:hover {
    animation-play-state: paused;
  }
  .ticker-content {
    display: flex;
    align-items: center;
    gap: 80px; 
    padding-right: 80px;
  }
  
  .client-logo {
    height: 48px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    filter: grayscale(100%) opacity(0.4) contrast(1.2);
    transition: filter 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    mix-blend-mode: multiply; /* Removes white backgrounds from jpgs */
  }
  .client-logo:hover { 
    filter: grayscale(0%) opacity(1) contrast(1);
    transform: scale(1.05);
  }

  @keyframes scrollTicker {
    to { transform: translateX(-50%); }
  }

  @keyframes scaleIn {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }
  @keyframes revealUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-title {
    font-family: var(--display);
    font-size: clamp(2.2rem, 4.5vw, 4.8rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    max-width: 20ch;
    margin: 0;
  }
  .hero-title strong {
    color: #FF5722; /* Safety Orange */
  }

  .hero-bottom-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px; /* Tighter gap */
    border-top: 2px solid rgba(255, 255, 255, 0.3);
    padding-top: 24px; /* Tighter padding */
    width: 100%;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    color: #FFFFFF;
    max-width: 40ch;
    margin: 0;
    line-height: 1.4;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-solid-radical {
    background: var(--accent);
    color: #FFF;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 16px 40px;
    text-decoration: none;
    transition: background 0.2s;
    border: 2px solid var(--accent);
    text-align: center;
  }
  .btn-solid-radical:hover { background: #FFF; color: #000; border-color: #FFF; }

  .btn-outline-radical {
    background: transparent;
    color: #FFF;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 16px 40px;
    text-decoration: none;
    border: 2px solid #FFF;
    transition: all 0.2s;
    text-align: center;
  }
  .btn-outline-radical:hover { background: #FFF; color: #000; }

  /* --- TYPOGRAPHY & STRUCTURE --- */
  .title-massive {
    font-family: var(--display);
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0;
    max-width: 15ch;
  }

  .title-section {
    font-family: var(--display);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* Manifesto Layout for Intro */
  .manifesto-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .manifesto-layout {
      grid-template-columns: repeat(12, 1fr);
      gap: 40px;
    }
    .manifesto-title {
      grid-column: 1 / -1;
      margin-bottom: 40px;
    }
    .manifesto-lead {
      grid-column: 1 / 7;
    }
    .manifesto-body {
      grid-column: 8 / 12;
      border-left: 2px solid var(--text-primary);
      padding-left: 24px;
    }
  }

  .grid-radical {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 1024px) {
    .grid-radical {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }

  .lead-radical {
    font-size: clamp(1.4rem, 2.5vw, 2.2rem);
    line-height: 1.25;
    font-weight: 500;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .body-radical {
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  .btn-solid-dark {
    display: inline-block;
    background: var(--text-primary);
    color: var(--bg-page);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 16px 32px;
    text-decoration: none;
    border: 2px solid var(--text-primary);
    transition: background 0.2s, color 0.2s;
  }
  .btn-solid-dark:hover { 
    background: var(--bg-page); 
    color: var(--text-primary); 
  }

  .mt-12 { margin-top: 32px; } /* Tighter margin */

  /* Full Width Image with Architectural Wipe */
  .full-width-image {
    width: 100%;
    height: 70vh;
    margin-top: 48px; /* Tighter margin */
    background: var(--concrete);
    position: relative;
    overflow: hidden;
  }
  .full-width-image img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
  }
  
  /* --- SCROLL REVEAL EFFECTS --- */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-on-scroll.delay-1 { transition-delay: 0.1s; }
  .reveal-on-scroll.delay-2 { transition-delay: 0.2s; }
  .reveal-on-scroll.delay-3 { transition-delay: 0.3s; }
  
  .reveal-on-scroll.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Specific effect for images */
  .image-reveal::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--text-primary);
    transform-origin: top;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;
  }
  .image-reveal.is-revealed::after {
    transform: scaleY(0);
  }
  .image-reveal img {
    transform: scale(1.1);
    transition: transform 2s cubic-bezier(0.16, 1, 0.3, 1) 0.5s;
  }
  .image-reveal.is-revealed img {
    transform: scale(1);
  }

  /* --- QUOTE SECTION --- */
  .quote-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  .quote-container blockquote {
    margin: 0;
  }
  .quote-container p {
    font-family: var(--display);
    font-size: clamp(2rem, 4vw, 4.5rem);
    line-height: 1.1;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 24px; /* Tighter margin */
  }
  .quote-container footer {
    font-family: var(--body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  /* --- HEADER RADICAL --- */
  .header-radical {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px; /* Reduced gap */
    margin-bottom: 48px; /* Tighter margin (was 80) */
    border-bottom: 2px solid var(--text-primary);
    padding-bottom: 24px; /* Tighter padding (was 40) */
  }
  .bg-black-radical .header-radical {
    border-bottom-color: rgba(255,255,255,0.2);
  }
  .header-radical-text {
    max-width: 800px;
  }

  .tiles-wrapper {
    /* Removing standard wrap margins, letting it bleed */
    width: 100%;
  }

  /* --- SLIDER --- */
  .slider-container {
    display: flex;
    align-items: center;
    gap: 20px;
    width: 100%;
  }
  .slider-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    flex: 1;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .slider-track::-webkit-scrollbar { display: none; }
  
  .slider-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
  }

  .video-card {
    position: relative;
    width: 100%;
    aspect-ratio: 16/7;
    background: #111;
  }
  @media (max-width: 768px) {
    .video-card { aspect-ratio: 1/1; }
  }
  
  .video-card video {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(80%) contrast(1.1);
  }
  
  .video-label {
    position: absolute;
    top: 0; left: 0;
    background: var(--accent);
    color: #FFF;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 16px 32px;
    font-size: 1.2rem;
  }

  .slider-btn {
    width: 80px;
    height: 80px;
    background: transparent;
    border: 2px solid #FFF;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .slider-btn:hover { background: #FFF; }
  .slider-btn:hover .arrow-icon { border-color: #000; }
  
  .arrow-icon {
    width: 20px; height: 20px;
    border-right: 3px solid #FFF;
    border-bottom: 3px solid #FFF;
    transform: rotate(-45deg);
  }
  .prev-btn .arrow-icon {
    transform: rotate(135deg);
  }

  /* --- VALUES GRID --- */
  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-left: 2px solid var(--text-primary);
  }
  @media (min-width: 768px) {
    .values-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .value-block {
    padding: 40px;
    border-right: 2px solid var(--text-primary);
    border-bottom: 2px solid var(--text-primary);
  }
  .value-block h3 {
    font-family: var(--display);
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--accent);
  }
  .value-block p {
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .offices-radical {
    margin-top: 80px;
    font-size: 1.4rem;
    font-weight: 500;
  }
  .offices-radical strong {
    border-bottom: 2px solid var(--text-primary);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Slider Logic
    const track = document.getElementById("procesos-slider");
    const prevBtn = document.querySelector(".prev-btn");
    const nextBtn = document.querySelector(".next-btn");

    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener("click", () => track.scrollBy({ left: -track.clientWidth, behavior: "smooth" }));
      nextBtn.addEventListener("click", () => track.scrollBy({ left: track.clientWidth, behavior: "smooth" }));
    }

    // Scroll Reveal Logic (Intersection Observer)
    const observerOptions = {
      root: null,
      rootMargin: "0px 0px -100px 0px", // Trigger slightly before it hits bottom
      threshold: 0.1
    };

    const scrollObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target); // Run once
        }
      });
    }, observerOptions);

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      scrollObserver.observe(el);
    });
  });
</script>
